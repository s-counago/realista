# Backend Environment Variables
# Copy this file to .env and fill in your values for local development
# In production (Railway), set these in the Railway dashboard

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/realistadb
DATABASE_USER=realistaDmin
DATABASE_PASSWORD=password
DDL_AUTO=update

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT Configuration
# Generate a secure secret for production:
# openssl rand -base64 64
JWT_SECRET=RealIstA-2026-S3cur3-JWT-T0ken-S1gn1ng-K3y-Ch4ng3-1n-Pr0duct10n
JWT_EXPIRATION_MS=86400000

# Logging (optional)
# SPRING_PROFILES_ACTIVE=dev

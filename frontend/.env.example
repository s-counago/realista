# Frontend Environment Variables
# Copy this file to .env.local for local development
# In production (Railway), set these in the Railway dashboard

# Backend API URL
NEXT_PUBLIC_BACKEND_API=http://localhost:8080/api

# NextAuth Configuration
# Generate a secure secret for production:
# openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here-change-in-production

# Google OAuth (optional, only if using Google sign-in)
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Base URL for auth redirects
NEXTAUTH_URL=http://localhost:3000
